# DevPulse AI Environment Variables Configuration
# Copy this file to .env.local for local development. NEVER commit real secrets to Git.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Phase 2: PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devpulse_ai?schema=public"

# Authentication Configuration (Phase 3: Auth Secret & Session)
AUTH_SECRET="devpulse_super_secret_session_encryption_key_min_32_characters"

# Artificial Intelligence (Phase 4 & 6: OpenAI Reasoning Engine)
OPENAI_API_KEY=""

# GitHub OAuth Integration (Phase 8)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
